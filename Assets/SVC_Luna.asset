            u_xlat1.xyz = u_xlat16_1.xyz * _Color.xyz;\n    u_xlat16_5.xyz = vec3(vec3(_Metallic,
            _Metallic, _Metallic)) * u_xlat16_5.xyz + vec3(0.0399999991, 0.0399999991,
            0.0399999991);\n    u_xlat16_32 = dot(u_xlat16_5.xyz, u_xlat16_5.xyz);\n   
            u_xlatb4 = u_xlat16_32!=0.0;\n    u_xlat4.x = u_xlatb4 ? 1.0 : float(0.0);\n   
            u_xlat27 = u_xlat27 * u_xlat4.x;\n    u_xlat4.xyz = u_xlat16_2.xyz *
            vec3(u_xlat27);\n    u_xlat16_32 = (-u_xlat0.x) + 1.0;\n    u_xlat16_6.x
            = u_xlat16_32 * u_xlat16_32;\n    u_xlat16_6.x = u_xlat16_6.x * u_xlat16_6.x;\n   
            u_xlat16_32 = u_xlat16_32 * u_xlat16_6.x;\n    u_xlat16_6.xyz = (-u_xlat16_5.xyz)
            + vec3(1.0, 1.0, 1.0);\n    u_xlat16_6.xyz = u_xlat16_6.xyz * vec3(u_xlat16_32)
            + u_xlat16_5.xyz;\n    u_xlat4.xyz = u_xlat4.xyz * u_xlat16_6.xyz;\n   
            u_xlat3.w = 1.0;\n    u_xlat16_6.x = dot(unity_SHAr, u_xlat3);\n    u_xlat16_6.y
            = dot(unity_SHAg, u_xlat3);\n    u_xlat16_6.z = dot(unity_SHAb, u_xlat3);\n   
            u_xlat16_6.xyz = u_xlat16_6.xyz + vs_TEXCOORD5.xyz;\n    u_xlat16_6.xyz
            = max(u_xlat16_6.xyz, vec3(0.0, 0.0, 0.0));\n    u_xlat16_32 = u_xlat0.x
            + u_xlat0.x;\n    u_xlat16_32 = u_xlat0.x * u_xlat16_32;\n    u_xlat16_32
            = u_xlat16_32 * u_xlat9.x + -0.5;\n    u_xlat16_33 = u_xlat16_29 * u_xlat16_29;\n   
            u_xlat16_33 = u_xlat16_33 * u_xlat16_33;\n    u_xlat16_29 = u_xlat16_29
            * u_xlat16_33;\n    u_xlat16_33 = u_xlat16_32 * u_xlat16_29 + 1.0;\n   
            u_xlat16_7.x = (-u_xlat28) + 1.0;\n    u_xlat16_16 = u_xlat16_7.x * u_xlat16_7.x;\n   
            u_xlat16_16 = u_xlat16_16 * u_xlat16_16;\n    u_xlat16_7.x = u_xlat16_7.x
            * u_xlat16_16;\n    u_xlat16_32 = u_xlat16_32 * u_xlat16_7.x + 1.0;\n   
            u_xlat16_32 = u_xlat16_33 * u_xlat16_32;\n    u_xlat0.x = u_xlat28 *
            u_xlat16_32;\n    u_xlat16_2.xyz = u_xlat0.xxx * u_xlat16_2.xyz;\n   
