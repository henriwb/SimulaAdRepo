            u_xlat8 = dot(u_xlat2.xyz, _WorldSpaceLightPos0.xyz);\n    u_xlat8 =
            clamp(u_xlat8, 0.0, 1.0);\n    u_xlat15 = (-u_xlat14) + 1.0;\n    u_xlat22
