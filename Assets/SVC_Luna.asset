            vec3 vs_TEXCOORD2;\nhighp vec3 vs_TEXCOORD3;\nvec4 u_xlat0;\nvec4 u_xlat1;\nvec3
            u_xlat2;\nvoid main()\n{\n    u_xlat0 = in_POSITION0.yyyy * hlslcc_mtx4x4unity_ObjectToWorld[1];\n   
