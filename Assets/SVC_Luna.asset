            u_xlat27 = u_xlat27 * u_xlat1.x;\n    u_xlat27 = u_xlat28 * u_xlat27;\n   
            u_xlat27 = u_xlat27 * 3.14159274;\n    u_xlat27 = max(u_xlat27, 0.0);\n   
            u_xlat16_1.xyz = texture(_MainTex, vs_TEXCOORD0.xy).xyz;\n    u_xlat16_5.xyz
