            0.0, 1.0);\n    u_xlat10 = u_xlat28 * u_xlat10 + u_xlat18;\n    u_xlat18
            = u_xlat18 * u_xlat18 + 1.0;\n    u_xlat18 = float(1.0) / u_xlat18;\n   
