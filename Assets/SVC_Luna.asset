            = (-u_xlat16_2.xxx) * u_xlat3.xyz + _WorldSpaceCameraPos.xyz;\n    u_xlat16_2.xyz
            = (-u_xlat0.xyz) + u_xlat1.xyz;\n    u_xlatb9 = _WaterHeight<u_xlat1.y;\n   
            u_xlat16_11 = (u_xlatb9) ? 1.0 : 0.0;\n    u_xlat16_2.xyz = vec3(u_xlat16_11)
            * u_xlat16_2.xyz + u_xlat0.xyz;\n    u_xlat0.x = u_xlat16_2.y * hlslcc_mtx4x4unity_MatrixVP[1].z;\n   
