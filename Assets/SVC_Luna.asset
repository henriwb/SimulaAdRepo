            u_xlat15;\nfloat u_xlat21;\nfloat u_xlat22;\nvoid main()\n{\n    u_xlat0.x
            = texture(_CameraDepthTexture, vs_TEXCOORD0.xy).x;\n    u_xlat7 = _ZBufferParams.x
            * u_xlat0.x + _ZBufferParams.y;\n    u_xlat7 = float(1.0) / u_xlat7;\n   
