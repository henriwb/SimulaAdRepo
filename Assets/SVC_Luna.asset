            u_xlatb1;\nvec4 u_xlat2;\nvec4 u_xlat3;\nmediump vec3 u_xlat16_3;\nvec4
            u_xlat4;\nvec4 u_xlat5;\nvec4 u_xlat6;\nfloat u_xlat7;\nvec3 u_xlat8;\nfloat
            u_xlat14;\nvec2 u_xlat15;\nfloat u_xlat21;\nfloat u_xlat22;\nvoid main()\n{\n   
            u_xlat0.z = texture(_CameraDepthTexture, vs_TEXCOORD0.xy).x;\n    u_xlat0.xy
            = vs_TEXCOORD0.zw;\n    u_xlat0.xyz = u_xlat0.xyz * vec3(2.0, 2.0, 2.0)
